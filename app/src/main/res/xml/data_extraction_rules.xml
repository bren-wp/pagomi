<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <!-- Private scanned files are excluded from both cloud and phone-to-phone backup. -->
  <cloud-backup>
    <exclude domain="root" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="." />
  </device-transfer>
</data-extraction-rules>
